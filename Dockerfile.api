FROM mambaorg/micromamba:1.5.10-noble

USER root
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install ARM64-incompatible-on-PyPI packages via conda-forge
RUN micromamba install -y -n base -c conda-forge \
    python=3.11 \
    openmm \
    pdbfixer \
    openmmforcefields \
    rdkit \
    openff-toolkit \
    openff-forcefields \
    openff-interchange \
    vina \
    && micromamba clean --all --yes

ENV PATH="/opt/conda/bin:$PATH"

# Dependencies come from pyproject.toml (single source of truth). Only pyproject.toml and the
# stdlib-only extractor are copied first, so this heavy layer caches until dependencies change,
# not on every source edit. Leaf extras only — see scripts/pyproject_deps.py for why `[all]`
# can't be passed. The project itself isn't pip-installed: commands run from /app.
COPY pyproject.toml scripts/pyproject_deps.py /tmp/deps/
RUN python /tmp/deps/pyproject_deps.py /tmp/deps/pyproject.toml ml modal tracking dev > /tmp/deps/requirements.txt \
    && pip install --no-cache-dir -r /tmp/deps/requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
