# Applies to both Dockerfile.api and Dockerfile.celery (`COPY . .`).
# Compose bind-mounts `.:/app` at runtime, so nothing here is needed inside the image.

# ---- Secrets — never bake into an image ----
.env
.env.*
!.env.example

# ---- VCS / local tooling ----
.git
.github
.claude
CLAUDE.local.md
.modal/

# ---- Python / test / lint caches ----
**/__pycache__
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# ---- Large or regenerable outputs ----
wandb/
benchmarks/proteingym_cache/
scripts/API-Testing/ColabFold-Testing/results/
*.a3m
*.m8
out.tar.gz
*.xvg
*.trr
*.edr
*.tpr
*.gro

# ---- Local run artifacts (outputs, not read at runtime) ----
# Listed by name rather than `*.pdb`: benchmarks/epistasis_structures/ has a tracked PDB.
result.pdb
myprotein.pdb
input.pka
benchmark_results.json
benchmarks/hivdb_cache/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Editors / OS / notebooks ----
.vscode/
.idea/
**/.DS_Store
**/*.swp
**/.ipynb_checkpoints/

# ---- Coverage / tox ----
.coverage
.coverage.*
htmlcov/
.tox/
